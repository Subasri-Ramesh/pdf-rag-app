# Generation provider: deepseek, ollama, or openai
LLM_PROVIDER=deepseek

# DeepSeek API configuration (recommended if you have a DeepSeek API key)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Default local alternative: free local generation through Ollama. No API key required.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434

# Optional alternative: set LLM_PROVIDER=openai and configure these values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Sentence Transformers model used for retrieval embeddings.
EMBEDDING_MODEL=all-MiniLM-L6-v2
